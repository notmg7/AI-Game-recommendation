# Copy this file to .env and fill in your own values. Never commit .env.

# IGDB API access (create an app at https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Optional: email for sign-up verification codes (Gmail app password recommended)
SENDER_EMAIL=your_email@example.com
SENDER_PASSWORD=your_email_app_password

# Optional: PostgreSQL connection string for library persistence
DATABASE_URL=postgresql://user:password@host:5432/dbname
